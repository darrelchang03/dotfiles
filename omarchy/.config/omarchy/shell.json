{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "mryll.meteobar",
          "location": "Foster City, California",
          "units": "imperial"
        },
        {
          "id": "tristonarmstrong.dictionary"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "io.github.ilyazar.syncthing"
        },
        {
          "id": "quickshell.spotify"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.weirdware.blueferry"
        },
        {
          "id": "io.github.silouanwright.look-elsewhere"
        },
        {
          "id": "omaplug"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "jankeesvw.notification-center"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "boot": "theme",
      "design": "poster"
    },
    {
      "id": "bobbynicholas.omaland"
    }
  ],
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "io.github.sirjul1337.lock-explorer"
  ]
}
