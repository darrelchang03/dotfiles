# --- Secrets ---------------------------------------------------------------
# NOTE: ignoring does nothing to already-tracked files; they must be
# `git rm --cached`ed first (and purged from history if already pushed).
/nvim/.config/ngrok/
/nvim/.config/github-copilot/apps.json
/bash/.bash_history
/personal/

# --- Location / machine identity -------------------------------------------
geo.toml
/nvim/.config/Ultralytics/

# --- Captured app state, not configuration ---------------------------------
/nvim/.config/GIMP/
/nvim/.config/xfce4/
/nvim/.config/wslu/
/nvim/.config/envman/
/nvim/.config/nvm
nvim/.config/go/telemetry/*
nvim/.config/htop/htop_history

# --- Generated / machine-local ---------------------------------------------
/kitty/.config/kitty/kitty.conf
flycheck_config.el
hyprmoncfg-monitors.lua

# --- Third-party omarchy plugins and themes --------------------------------
# Independent git clones that live inside this repo (~/.config/omarchy is a
# symlink into it). They were recorded as bare gitlinks with no .gitmodules,
# so a fresh clone produced 16 empty directories and no way to populate them.
# Reinstalled by ~/personal/dev/runs/omarchy-{plugins,themes} instead.
# tema is not a git clone, so it stays tracked.
/omarchy/.config/omarchy/plugins/
/omarchy/.config/omarchy/themes/*
!/omarchy/.config/omarchy/themes/tema/
